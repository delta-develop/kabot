# Twilio configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14150000000

# OpenAI configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.7

# Cognitive memory settings
MAX_TURNS=10

# Host ports. Superset workspace setup overwrites these with a reserved block.
PORT_BASE=8000
CORE_API_PORT=8000
AGENT_PORT=8001
MEMORY_PORT=8002
POSTGRES_PORT=5432
MONGO_PORT=27017
REDIS_PORT=6379
