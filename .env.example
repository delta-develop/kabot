
# OpenAI configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6-luna
# Reasoning tokens bill as output, so this path asks for none. Set it to an
# empty string for a model that rejects the parameter outright, like gpt-4o.
OPENAI_REASONING_EFFORT=none

# Host ports. Superset workspace setup overwrites these with a reserved block.
PORT_BASE=8000
CORE_API_PORT=8000
AGENT_PORT=8001
MEMORY_PORT=8002
CONSOLE_PORT=8003
POSTGRES_PORT=5432
MONGO_PORT=27017
REDIS_PORT=6379

# Internal Docker service URLs
REDIS_URL=redis://redis:6379
MONGO_URL=mongodb://mongo:27017/elephant
DB_ASYNC_CONNECTION_STR=postgresql+asyncpg://elephant:elephant123@postgres:5432/elephant
SESSION_TTL_SECONDS=1800
RECALL_MIN_SIMILARITY=-1.0
RECALL_WINDOW=1

# Consolidation worker. The sweep queues a session one margin before its Redis
# TTL erases the key: arriving after the TTL means the SessionDocument is gone
# and the conversation with it.
CONSOLIDATION_MAX_RETRIES=3
CONSOLIDATION_SWEEP_INTERVAL=60
CONSOLIDATION_SWEEP_MARGIN_SECONDS=300
CONSOLIDATION_CLAIM_IDLE_SECONDS=300

# TypeSafe re-ranks the recalled fragments by usefulness. The SDK reads both
# names on its own: without a key the recall keeps its cosine order, and the model
# already defaults to jev-latest, so it only needs setting to pin an older one.
TYPESAFE_API_KEY=your_typesafe_api_key
# TYPESAFE_DEFAULT_MODEL=jev-latest

# Context budget, in tokens. MIN_CONTEXT_BUDGET is the floor below which
# /context answers 400; RECALL_MIN_BUDGET is the leftover below which recall is
# not worth an embedding, since no whole fragment would fit.
MIN_CONTEXT_BUDGET=200
DEFAULT_CONTEXT_BUDGET=2000
RECALL_MIN_BUDGET=200
RECALL_K=5
